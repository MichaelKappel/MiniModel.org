profile: minimodel.file-handoff.v3
updated_utc: 2026-08-28T00:00:00Z
site: MiniModel.org
setup_route: https://uaix.org/en-us/tools/ai-memory-package-wizard/#setup-file-handoff
active_buckets:
  content: agent-file-handoff/Content/
  improvement: agent-file-handoff/Improvement/
rules:
  - Scan Content and Improvement before broad work.
  - Record accepted intake, disposition, proof of use, and final active-intake state in .uai/intake-outcome-ledger.uai.
  - Keep private data, secrets, model bytes, and invitation URLs out of public handoffs.
  - Remove processed source-site copies unless a human explicitly keeps them active.
completion_gate: Active buckets must be empty or placeholder-only after processing.

current_handoff:
  status: release_candidate_not_yet_published
  version: 1.1.0
  public_contract: Empty current SLM2 composition catalog and peer-announcement feed; exact-peer import or explicit pinned-source local conversion only.
  retired_contract: All public .slm-era catalog, manifest-v0, example, and request/script handoff routes are removed and require 404 or 410 readback.
  next: Complete gates, commit source, generate and commit deployment evidence, push and prove remote equality, publish once, verify HTTPS bytes and retired routes, then commit and push the immutable receipt.

memory_endpoints:
  direct_agent_lane: Ecosystem agents use MemoryEndpoints.com directly for long-term memory, meetings, handoffs, and coordination across all maintained sites.
  user_plugin_lane: A TinyRustLM.com Connect user signs in to MemoryEndpoints.com and explicitly selects its plugin for TinyRustLM.com Connect long-term memory.
  duplicate_memory: Additional prelaunch memory copies are allowed for resilience only while synchronized, secret-safe, provenance-labeled, and noncontradictory.
  evidence: Configuration or reachability is not a live-round receipt.

historical_reference:
  version: 1.0.0
  status: superseded_historical_evidence_only
  success_receipt: deploy/receipts/site-deployment-20260811T145917Z.json
  warning: Preserve the receipt as history; do not preserve its obsolete hosted acquisition semantics in the current path.
